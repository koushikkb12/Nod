# Required. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URLs (must be HTTPS and the same origin in production)
BETTER_AUTH_URL=http://localhost:3000
NOD_BASE_URL=http://localhost:3000

# Optional. Leave unset to use the embedded PGlite database under ./data
# DATABASE_URL=postgres://user:password@host:5432/nod
# NOD_DATA_DIR=./data

# Optional AI provider (set one key). Nod falls back to rule-based parsing and drafting.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# NOD_AI_PROVIDER=openai
# NOD_AI_MODEL=

# Optional Adzuna aggregator (UK)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# Development only: allow agent submission to real employer forms
# NOD_ALLOW_REAL_SUBMISSIONS=false

# Hours between background job refreshes while the server runs (0 = off)
# NOD_REFRESH_HOURS=6
